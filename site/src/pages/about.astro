---
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { getPosts } from "../lib/posts";
import { SITE, url, absUrl } from "../site";

const latest = (await getPosts()).slice(0, 3);
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    url: absUrl("/about/"),
    mainEntity: {
      "@type": "Person",
      name: SITE.author,
      jobTitle: SITE.jobTitle,
      url: SITE.socials.website,
      image: absUrl(SITE.ogImage),
      sameAs: [SITE.socials.linkedin, SITE.socials.github, SITE.socials.scholar],
      knowsAbout: ["Machine Learning", "Recommender Systems", "NLP", "Time Series Forecasting", "Customer Segmentation", "Generative AI"],
    },
  },
];
---

<Base
  title="About"
  description="Adarsh Nair is a Senior Data Science leader with 10 years of experience in ML-driven marketing analytics, recommender systems, NLP and forecasting."
  path="/about/"
  type="profile"
  jsonLd={jsonLd}
>
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">About</p>
      <h1>{SITE.author}</h1>
      <p>Data Scientist · Machine Learning Engineer · Senior Data Science Manager</p>
    </header>
    <div class="about-grid">
      <div class="prose">
        <p>
          Adarsh Nair is a Senior Data Science leader with 10 years of experience delivering ML-driven marketing analytics
          and personalization at scale. He has a proven track record of leading teams building recommender systems,
          customer segmentation, and forecasting solutions using Python, TensorFlow, AWS, and Kafka.
        </p>
        <p>
          Adarsh has deep expertise in NLP, time series modeling, feature engineering, model validation, and deploying
          production-grade APIs with FastAPI. He is passionate about leveraging data to drive business value and create
          impactful user experiences.
        </p>
        <div class="btn-row">
          <a class="btn" href={url("/cv/")}>View CV</a>
          <a class="btn ghost" href={SITE.socials.linkedin} rel="me noopener">LinkedIn</a>
          <a class="btn ghost" href={SITE.socials.github} rel="me noopener">GitHub</a>
          <a class="btn ghost" href={`mailto:${SITE.socials.email}`}>Email</a>
        </div>
      </div>
      <img src={url("/assets/img/prof_pic_color.png")} alt="Portrait of Adarsh Nair" width="260" height="320" />
    </div>

    <div class="section-title" style="margin-top:48px"><h2>Latest writing</h2></div>
    <div class="post-grid">{latest.map((p) => <PostCard post={p} heading="h3" />)}</div>
  </div>
</Base>
