---
import TermPage from "../../../components/TermPage.astro";
import { getPosts, collectTerms, slugify } from "../../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return collectTerms(posts, "tags").map((term) => ({
    params: { tag: term.slug },
    props: { term, posts: posts.filter((p) => p.tags.some((t) => slugify(t) === term.slug)) },
  }));
}
const { term, posts } = Astro.props;
---

<TermPage term={term} kind="tag" posts={posts} />
