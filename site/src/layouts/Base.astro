---
import "../styles/global.css";
import { SITE, url, absUrl } from "../site";

interface Props {
  title?: string;
  description?: string;
  path: string; // path relative to base, used for canonical
  image?: string;
  type?: "website" | "article" | "profile";
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  published?: Date;
  modified?: Date;
  tags?: string[];
  katex?: boolean;
  prev?: string;
  next?: string;
}

const {
  title,
  description = SITE.description,
  path,
  image = SITE.ogImage,
  type = "website",
  jsonLd = [],
  noindex = false,
  published,
  modified,
  tags = [],
  katex = false,
  prev,
  next,
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE.title}` : `${SITE.blogName} | ${SITE.title}`;
const canonical = absUrl(path);
const ogImage = image.startsWith("http") ? image : absUrl(image);
const current = Astro.url.pathname;

const siteGraph = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.blogName,
    url: absUrl("/"),
    inLanguage: SITE.lang,
    author: { "@type": "Person", name: SITE.author, url: absUrl("/about/") },
    potentialAction: {
      "@type": "SearchAction",
      target: `${absUrl("/explore/")}?q={search_term_string}`,
      "query-input": "required name=search_term_string",
    },
  },
];
const ld = path === "/" ? [...siteGraph, ...jsonLd] : jsonLd;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {prev && <link rel="prev" href={absUrl(prev)} />}
    {next && <link rel="next" href={absUrl(next)} />}
    <meta name="author" content={SITE.author} />
    {SITE.googleSiteVerification && <meta name="google-site-verification" content={SITE.googleSiteVerification} />}
    {SITE.bingSiteVerification && <meta name="msvalidate.01" content={SITE.bingSiteVerification} />}
    {SITE.adsense.client && <meta name="google-adsense-account" content={SITE.adsense.client} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121417" media="(prefers-color-scheme: dark)" />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⚛️</text></svg>"
    />
    <link rel="alternate" type="application/rss+xml" title={SITE.blogName} href={url("/feed.xml")} />
    <link rel="sitemap" href={url("/sitemap.xml")} />

    <!-- Open Graph / Twitter -->
    <meta property="og:site_name" content={SITE.blogName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.blogName} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={SITE.locale} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {type === "article" && <meta property="article:author" content={SITE.author} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title ?? SITE.blogName} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}

    <!-- Set theme before paint to avoid a flash -->
    <script is:inline>
      (() => {
        let t = null;
        try { t = localStorage.getItem("theme"); } catch {}
        if (t !== "light" && t !== "dark") t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = t;
      })();
    </script>

    {
      import.meta.env.PROD && SITE.googleAnalytics && (
        <>
          <script is:inline define:vars={{ id: SITE.googleAnalytics, host: new URL(SITE.origin).hostname }}>
            // Only count real visitors on the live domain (not localhost previews).
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            window.gtag = gtag;
            if (location.hostname === host) {
              const s = document.createElement("script");
              s.async = true;
              s.src = "https://www.googletagmanager.com/gtag/js?id=" + id;
              document.head.appendChild(s);
              gtag("js", new Date());
              gtag("config", id);
            }
          </script>
        </>
      )
    }
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={url("/")} aria-label={`${SITE.blogName} home`}>
          <span class="brand-mark" aria-hidden="true">AN</span>
          <span class="brand-text">
            <strong>{SITE.title}</strong>
            <small>{SITE.blogName}</small>
          </span>
        </a>
        <nav class="nav" aria-label="Main">
          {
            SITE.nav.map((item) => {
              const href = url(item.href);
              const active =
                item.href === "/"
                  ? current === href || current.startsWith(url("/page/")) || current.startsWith(url("/blog/"))
                  : current.startsWith(href);
              return (
                <a href={href} aria-current={active ? "page" : undefined}>
                  {item.label}
                </a>
              );
            })
          }
        </nav>
        <div class="header-actions">
          <button class="icon-btn search-trigger" type="button" data-search-open aria-label="Search posts (Ctrl K)">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
            <span class="kbd" aria-hidden="true">⌘K</span>
          </button>
          <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle dark mode">
            <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
            <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path></svg>
          </button>
          <button class="icon-btn menu-btn" type="button" data-menu-toggle aria-expanded="false" aria-label="Open menu">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p>© {new Date().getFullYear()} {SITE.author}. Writing about machine learning, AI and data science.</p>
        <nav aria-label="Footer">
          <a href={url("/feed.xml")}>RSS</a>
          <a href={url("/blog/tag/")}>Topics</a>
          <a href={SITE.socials.github} rel="me noopener">GitHub</a>
          <a href={SITE.socials.linkedin} rel="me noopener">LinkedIn</a>
          <a href={SITE.socials.scholar} rel="me noopener">Scholar</a>
          <a href={url("/toolkit/")}>Toolkit</a>
          <a href={url("/disclosure/")}>Affiliate disclosure</a>
          <a href={url("/privacy/")}>Privacy</a>
        </nav>
      </div>
    </footer>

    <dialog class="search-dialog" aria-label="Search posts">
      <div class="search-shell">
        <div class="search-head">
          <span>Search {SITE.blogName}</span>
          <button class="icon-btn" type="button" data-search-close aria-label="Close search">✕</button>
        </div>
        <div id="pagefind-search"></div>
        <p class="search-hint">Tip: press <kbd>/</kbd> or <kbd>⌘K</kbd> anywhere to search.</p>
      </div>
    </dialog>

    <script is:inline type="application/json" id="ads-config" set:html={JSON.stringify({ client: SITE.adsense.client })} />
    <script>
      import { initChrome } from "../lib/chrome";
      import { initAds, initTracking } from "../lib/monetize";
      initChrome();
      initTracking();
      initAds();
    </script>
  </body>
</html>
